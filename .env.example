# Copiá este archivo como .env (no se commitea) para desarrollo.
# En producción estos valores se hornean en el build con `npm run gen:secrets`
# (leen el entorno de la máquina que compila, o este mismo .env).

# ── MATIAS API (facturación electrónica DIAN) ────────────────────────────────
# Key única del desarrollador — común a todas las instalaciones ("Casa de Software").
MATIAS_API_KEY=
# Opcional. Default: https://sandbox-api.matias-api.com/api/ubl2.1
# MATIAS_API_URL=

# ── Turso (base de datos en la nube) ────────────────────────────────────────
# Base POR DEFECTO. Sirve para tu propio despliegue / pruebas.
# Cada negocio en producción carga SU propia base desde Ajustes → "Conexión a la Nube"
# (se guarda cifrada en userData, no acá).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
